{
  "name": "electron-shadcn-react-starter",
  "version": "0.0.0",
  "private": true,
  "description": "Electron shadcn react starter",
  "author": "tlyboy",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "tsc && vite build && electron-builder",
    "build:linux": "tsc && vite build && electron-builder --linux",
    "build:mac": "tsc && vite build && electron-builder --mac",
    "build:win": "tsc && vite build && electron-builder --win",
    "dev": "vite",
    "format": "oxfmt .",
    "lint": "oxlint",
    "preview": "vite preview",
    "release": "tsc && vite build && electron-builder --publish always"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "electron": "^43.7.3",
    "electron-builder": "^26.15.3",
    "oxfmt": "0.72.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^0.29.1"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.6.0"
}
