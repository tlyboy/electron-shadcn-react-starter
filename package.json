    "dev": "electron-forge start",
    "format": "oxfmt .",
    "lint": "oxlint",
    "make": "electron-forge make",
    "package": "electron-forge package",
    "publish": "electron-forge release",
    "release": "electron-forge release",
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
